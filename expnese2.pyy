import sqlite3

DB_NAME = "expenses.db"

def init_db():
    """Inicializon databazën dhe krijon tabelën nëse nuk ekziston."""
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("""
        CREATE TABLE IF NOT EXISTS expenses (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            description TEXT NOT NULL,
            amount REAL NOT NULL
        )
    """)
    
    # Pastron të gjitha shënimet (e nevojshme për TDD)
    c.execute("DELETE FROM expenses")

    conn.commit()
    conn.close()


def add_expense(description, amount):
    """Shton një shpenzim të ri – Feature 1."""
    if not description or amount < 0:
        raise ValueError("Invalid expense data")

    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("INSERT INTO expenses (description, amount) VALUES (?, ?)",
              (description, amount))
    conn.commit()
    conn.close()


def get_all_expenses():
    """Kthen listën e të gjitha shpenzimeve."""
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT * FROM expenses")
    rows = c.fetchall()
    conn.close()
    return rows


def delete_expense(expense_id):
    """Fshin një shpenzim sipas ID – Feature 2."""
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("DELETE FROM expenses WHERE id=?", (expense_id,))
    conn.commit()
    conn.close()


def update_expense(expense_id, description, amount):
    """Përditëson një shpenzim ekzistues – Feature 3."""
    if not description or amount < 0:
        raise ValueError("Invalid updated data")

    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()

    # Kontrollo nëse ekziston ID-ja
    c.execute("SELECT * FROM expenses WHERE id=?", (expense_id,))
    exists = c.fetchone()
    if exists is None:
        conn.close()
        raise ValueError("Expense not found")

    # Përditëso
    c.execute("""
        UPDATE expenses
        SET description=?, amount=?
        WHERE id=?
    """, (description, amount, expense_id))

    conn.commit()
    conn.close()
